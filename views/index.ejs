<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= data.title %></title>
  <meta name="description" content="<%= data.description %>">
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <header class="header">
    <a class="logo" href="/"><% if (data.logo) { %><img src="<%= data.logo %>" alt="Lab Creator"><% } else { %>Lab Creator<% } %></a>
    <nav>
      <a href="#services">Services</a><a href="#products">Products</a><a href="#projects">Projects</a><a href="#industries">Industries</a><a href="#contact">Contact</a>
    </nav>
    <a class="btn" href="#contact">Get a free quote</a>
  </header>

  <!-- Hero -->
  <section class="hero">
    <p class="eyebrow">Strategic · Innovate · Excellence</p>
    <h1>Complete your lab setup, from first sketch to final install.</h1>
    <p class="lead">Laboratory furniture, fume hoods, biosafety cabinets and turnkey lab construction by one team.</p>
    <a class="btn gold" href="#contact">Talk to our experts</a>
  </section>

  <section id="services" class="section">
    <h2>Services that help you grow</h2>
    <div class="grid">
      <% data.services.forEach(s => { %>
        <article class="card"><h3><%= s.title %></h3><p><%= s.text %></p></article>
      <% }) %>
    </div>
  </section>

  <section id="products" class="section dark">
    <h2>Products &amp; manufacturing</h2>
    <div class="grid">
      <% data.products.forEach(p => { %>
        <a class="card dark-card" href="<%= p.link %>"><h3><%= p.title %></h3><p><%= p.text %></p></a>
      <% }) %>
    </div>
  </section>

  <section class="section">
    <h2>Our working process</h2>
    <div class="grid">
      <% data.process.forEach((s, i) => { %>
        <article><div class="step">0<%= i + 1 %></div><h3><%= s.title %></h3><p><%= s.text %></p></article>
      <% }) %>
    </div>
  </section>

  <section id="projects" class="section light">
    <h2>Our projects</h2>
    <div class="grid">
      <% data.projects.forEach(p => { %>
        <article class="card">
          <% if (p.image) { %><img class="thumb" src="<%= p.image %>" alt="<%= p.title %>" loading="lazy"><% } %>
          <h3><%= p.title %></h3><p><%= p.text %></p>
        </article>
      <% }) %>
    </div>
  </section>

  <section class="section two-col">
    <div>
      <h2>FAQ</h2>
      <% data.faq.forEach(f => { %><h3><%= f.q %></h3><p><%= f.a %></p><% }) %>
    </div>
    <div>
      <h2>Testimonials</h2>
      <% data.testimonials.forEach(t => { %>
        <blockquote class="card"><p><%= t.quote %></p><strong><%= t.name %></strong></blockquote>
      <% }) %>
    </div>
  </section>

  <section id="industries" class="section light center">
    <h2>Industries we serve</h2>
    <div class="chips">
      <% data.industries.forEach(i => { %><span class="chip"><%= i.name %></span><% }) %>
    </div>
  </section>

  <!-- Contact form: POSTs to /contact in server.js -->
  <section id="contact" class="section two-col">
    <div>
      <h2>Talk to our experts</h2>
      <p><strong><%= data.email %></strong></p>
      <p><strong><%= data.phone %></strong></p>
      <p><%= data.address %></p>
    </div>
    <form class="card form" method="post" action="/contact">
      <% if (sent) { %><p class="ok">Thank you! We will get back to you soon.</p><% } %>
      <label>Your name<input name="name" required></label>
      <label>Your email<input name="email" type="email" required></label>
      <label>Your number<input name="phone" type="tel" required></label>
      <label>Message<textarea name="message" rows="4" required></textarea></label>
      <button class="btn" type="submit">Send message</button>
    </form>
  </section>

  <footer class="footer">
    <p>Lab Creator, a brand of Chameza Group. ISO 9001:2015 certified.</p>
    <p class="small">Content source: <%= data.source %></p>
  </footer>

</body>
</html>
